[
{"type": "bgm", "action": "play", "name": "低气压压抑氛围"},
  {"type": "dialogue", "role_name": "我", "text_content": "基督啊，", "emotion": "低落", "intensity": "稍弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我自言自语道，第一片雪花开始飘落。它们糊成毛茸茸的一团，覆在挡风玻璃上，又被雨刷抹去。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我已经在姐姐家的车道上等了十五——不，二十分钟了。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "要是刚才选择进屋陪她等，这会儿估计已经被她那两只灰色的猫送去见上帝了。可爱的小恶魔，但对我的鼻窦来说就是致命毒药。眼睛浮肿、喉咙堵塞——正是我最需要的。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "每年圣诞节，我们家都会长途跋涉，去爷爷奶奶那座藏在阿拉斯加霍普镇森林里的小木屋。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我本想赶在预报的那场大雪之前到达。但姐姐的驾照因为酒驾被吊销了，于是我成了时间的俘虏——手指焦躁地敲着方向盘。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "当初妈妈让我来接姐姐时，我心里就一百个不情愿。不是我们彼此憎恨，只是没那么亲近了。几十年无休止的争吵和激烈的分歧之后，我们渐渐疏远，关系也随之冷却。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "没错，我们是手足，但说我们是“手足残留下的余烬”恐怕更贴切。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "终于，像瓦尔哈拉的大门敞开一般，她的前门开了，她走了出来。头发是森林绿的。上次我见她时还是白色，再上次是紫罗兰色。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "都带齐了吗？", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她笨手笨脚地爬进副驾驶座时，我问道。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "嗯，", "emotion": "平静", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她应了一声，扶了扶眼镜，把几个袋子扔到后座。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "就这样，我们出发了。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "霍普镇大约三十分钟车程，车里的尴尬沉默没多久就膨胀开来。收音机坏了，辅助插口也断掉了，放起音乐活像在癫痫发作——这显然没有任何帮助。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "等我们拐上霍普公路的岔道时，路面已经铺成厚厚一层白毯。好在平安夜的晚上，通往霍普小镇那长长一段路空旷又安静。小木屋藏在主路五英里外的一片密林堡垒中。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "bgm", "action": "play", "name": "宁静不祥"},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我转弯时，姐姐摇下车窗，掏出一根大麻烟卷，用打火机点燃。", "emotion": "平静", "intensity": "中等", "break_duration": 0, "sfx": [{"name": "打火机点火声", "position": 0.5}]},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "来一口？", "emotion": "平静", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "车轮碾过雪地，嘎吱作响。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "开车的时候不行。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "直路一条。我们差不多到了。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她吸了一口，朝窗外吐出一团烟雾。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "我只想专心开车，行吗？", "emotion": "生气", "intensity": "稍弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她哼了一声，推了推眼镜。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "你要真那么紧张，不如开慢点。", "emotion": "生气", "intensity": "稍弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "来了，那一刺，一块引我上钩的饵。但我这次不咬钩。她想让我们更快到达，由她想去吧。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "车程快结束了，马上我就能坐在温暖的客厅里，翘起脚，手里端着一杯加了烈酒的蛋奶酒，耳边响起鲍比·赫尔姆斯的《铃铛摇滚》。", "emotion": "高兴", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我甚至已经能想象杰德叔叔又甩出他那恶俗笑话：圣诞老人为什么有那么大的——", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "bgm", "action": "play", "name": "诡异音乐迷雾"},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "哥们儿！", "emotion": "害怕", "intensity": "强烈", "break_duration": 0, "sfx": [{"name": "惊悚声", "position": 0.0}, {"name": "心跳声", "position": 0.5}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "姐姐尖叫起来，手指戳在我腰上，把我的思绪猛地拽回挡风玻璃前。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "车子刚刚绕过那条茂密的小径。一头驯鹿庞大的身躯挡在我们正前方。眼睛圆睁，空洞无神，即便高光束灯照上去也纹丝不动。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "惊慌之下，我猛打方向盘，拼命想避开。车子滑溜溜地侧偏过去，溅起一片碎雪泥。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那头驯鹿——也就是北美驯鹿——依然一动不动，保险杠从它鼻子前几英寸的地方呼啸而过。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我们在主路外的一侧嘎吱一声刹住。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "天哪，", "emotion": "害怕", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我松了口气，庆幸不已，", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "撞到了吗？", "emotion": "害怕", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "没有，", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "姐姐说着，探出车窗看了一眼，又吐出一口烟。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我把方向盘打正，踩下油门。车轮在原地尖啸，甩起一团团冰渣，却纹丝不动。", "emotion": "生气", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "完美。", "emotion": "生气", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我呻吟着，从座椅上把自己拆下来，下车查看。两个前轮裹满了黑乎乎的泥雪，几乎被积雪吞没。我踢了几脚，想把轮纹和轮拱下的冰渣弄掉。踢累了，只好用手指去刮。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "滚远点，普兰瑟，", "emotion": "生气", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我听见姐姐朝那头驯鹿的黑影喊道，它的鹿角像扭曲的手指伸向树梢。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "接着她发出一声短促的惊呼，", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "什么鬼？", "emotion": "害怕", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我从积雪中抬起头来。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那头驯鹿现在正用两条后腿直立着。看起来怪怪的，像童书里那种滑稽的拟人化形象。但在寂静的树林里，这画面令人毛骨悚然。它那模糊的身形仅凭两条腿站立，竟保持着近乎人类的平衡。不知为何，我这才注意到它没有尾巴。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "它肌肉发达的脖子扭向一侧，发出一声悠长的尖叫——金属碾磨金属的惨烈哀嚎。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0, "sfx": [{"name": "金属刮擦声", "position": 0.5}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我的双腿像冰雕一样把我钉在原地，那尖叫渐渐化作一连串湿漉漉的咕噜声。驯鹿落回原来的姿态，重重地跺着地面。一团团白气和几缕鼻涕从它的鼻孔里喷出来。我不是猎人，但被激怒的动物要冲过来了，这点常识我还是有的。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我扑向驾驶座，拉开车门，砰地关上，与此同时蹄子沉闷的撞击声已经追到我身边。鹿角刮过车门，它庞大的身躯几乎擦着我刚才站过的那片地飞掠而过。快，太快了。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "bgm", "action": "play", "name": "恐怖悬疑BGM"},
  {"type": "dialogue", "role_name": "旁白", "text_content": "姐姐尖叫起来，那头硕大的“名人”转身又冲了回来，这次撞碎了前大灯，把我们吞没在黑暗中。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0, "sfx": [{"name": "玻璃破碎", "position": 0.8}]},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "快走啊！", "emotion": "害怕", "intensity": "强烈", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "我在试，该死的！", "emotion": "生气", "intensity": "强烈", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "车轮继续无助地空转。我们被困住了。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那东西再次冲撞，这次正中车窗。姐姐脑袋旁边绽开一片蛛网般的裂纹。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0, "sfx": [{"name": "玻璃破碎", "position": 0.3}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我拼命搜寻任何——任何能当武器的东西。我从来不是什么枪械爱好者，但在那一刻，如果手里能有一把格洛克，我愿意剃光头发，加入世俗僧侣团。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那驯鹿又撞击了车身一次，终于像是失去了兴趣，消失在树丛之间。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "暂时有了喘息和思考的时间，我们给爸爸打了电话，告诉他情况。他会开着他的皮卡过来，帮我们把车弄出来，摆脱这团乱麻。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我转头看向姐姐，她正把手指捂在脸上，缓慢而平稳地呼吸着。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "你还好吗？", "emotion": "关心", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "你说呢？", "emotion": "生气", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她嘟囔道。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "我让你开慢点。", "emotion": "生气", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "又是一刺，这次我不打算忍了。", "emotion": "生气", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "你想帮上忙？", "emotion": "生气", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我吼道，", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "那就下去推车！不想？那就他妈闭嘴！我不需要这个。", "emotion": "生气", "intensity": "强烈", "break_duration": 0.5},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她不再说话，我也不再开口，重新陷入那种沉默——我们的关系早已沦落至此。但愿爸爸的车灯早点在远处亮起。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "bgm", "action": "play", "name": "安静诡异"},
  {"type": "dialogue", "role_name": "旁白", "text_content": "忽然，她摇下了车窗。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "你干什么？", "emotion": "疑惑", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "嘘。", "emotion": "平静", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她抿起嘴唇。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "仔细听。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0.5},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我姑且配合她，等了等。果然，我也听到了那个声音。外面传来一个小女孩的、轻柔的嗓音。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "bgm", "action": "play", "name": "铃声演奏的诡异音乐"},
  {"type": "dialogue", "role_name": "神秘声音", "text_content": "有人吗，", "emotion": "害怕", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "它呜咽着，", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "神秘声音", "text_content": "我迷路了。请帮帮我——我迷路了。", "emotion": "害怕", "intensity": "强烈", "break_duration": 0.3},
  {"type": "dialogue", "role_name": "旁白", "text_content": "姐姐解开车锁，伸手要开门。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我一把抓住她的手腕。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "你干什么？", "emotion": "生气", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "她厉声道，", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "dialogue", "role_name": "姐姐", "text_content": "外面有人！", "emotion": "害怕", "intensity": "强烈", "break_duration": 0},
  {"type": "dialogue", "role_name": "我", "text_content": "等一下！这不对劲，不是吗？", "emotion": "害怕", "intensity": "较强", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那声音继续哀泣着，在啜泣和哀求之间哽咽，求任何人帮帮她。我不喜欢那声音的质感。同样的拖腔，同样的哭诉，就像有人在反复播放一段录音。不对劲，我的直觉在各个方向竖起红旗。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "然后姐姐看向我，她的表情骤然扭曲成惊骇。她猛地往后一缩，双肩紧贴车内饰。一些像词句的东西从她喉咙里冒出来，却没能成形。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我转过身，看见了正盯着我的东西。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0.5, "sfx": [{"name": "巨大心跳声", "position": 0.5}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "它长着一张男人的脸，嵌在斑驳的驯鹿皮毛之间。皮肤是木乃伊般的褐色，像老旧皱缩的皮革一般，紧紧裹在它修长的头骨上。雪花落在它那双大而空洞的眼睛上，融化进瞳孔暗色的膜中。它绕着车子踱步，晃动鹿角，往车窗上呵气，向内窥视。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0.3, "sfx": [{"name": "怪物低沉的哀鸣声", "position": 0.7}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我的心撞击着喉咙的壁。我和姐姐四目相对，在彻底的不可置信中，一个字也说不出来。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我本该抓起手机。拍张照。录段视频。什么都好。但我的思绪乱作一团。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "紧接着，它再次发出那声可怕的尖叫，但我没看见它紧闭扭曲的嘴唇张开。声音是从它脖子里传来的……", "emotion": "害怕", "intensity": "微弱", "break_duration": 0, "sfx": [{"name": "金属刮擦声", "position": 0.2}, {"name": "鬼叫声", "position": 0.6}]},
  {"type": "dialogue", "role_name": "旁白", "text_content": "小小的、肉质的孔洞，像嘴巴一样翕动着，把那高亢的尖啸转变成模仿的小女孩哭喊：", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "神秘声音", "text_content": "帮帮我——我迷路了。帮帮我。", "emotion": "害怕", "intensity": "强烈", "break_duration": 0.2},
  {"type": "dialogue", "role_name": "旁白", "text_content": "车灯照亮了整个区域。爸爸的皮卡出现了，沿着小路驶来。那头驯鹿——管它他妈的是什么——跑了，再次消失在白雪覆盖的密林里。", "emotion": "平静", "intensity": "中等", "break_duration": 0},
  {"type": "bgm", "action": "stop"},
  {"type": "dialogue", "role_name": "旁白", "text_content": "没有人相信我们。怎么会呢？如果有人跟我讲这个故事，我也会以为他们磕了某种迷幻药。但我亲眼所见的现实是冰冷的，至今我仍无法完全咽下。那一夜，我和姐姐没有睡觉，而是查了一些资料，最终找到了关于“皮行者”的传说——某种存在，能模仿声音，伪装成动物，将人诱入林中。读完其他目击记录后，我毫不怀疑我们那晚目睹了什么。", "emotion": "低落", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "那天夜里，我不时望向窗外，扫视院子，想着会不会看见那张皮革似的脸从树线边注视着我。", "emotion": "害怕", "intensity": "微弱", "break_duration": 0},
  {"type": "dialogue", "role_name": "旁白", "text_content": "我和姐姐再也没有去过那趟旅行，这让家人们很是恼火。但乌云背后总有一线光明——我们俩从未像现在这样亲近过。", "emotion": "高兴", "intensity": "微弱", "break_duration": 0}
]