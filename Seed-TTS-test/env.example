# 复制为当前 shell 的变量来源后，按本机实际离线资源修改；不要提交 .env 或真实机器路径。
# 例：source Seed-TTS-test/env.example（其中 /path/to 必须先替换）

export HF_MIRROR_ROOT=/path/to/hf-mirror
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export ARNOLD_WORKER_GPU=1

# 官方 Seed-TTS-Eval 数据与评分资源。
export SEED_TTS_DATA_ROOT=/path/to/seedtts_testset
export SEED_TTS_WAVLM_CKPT=/path/to/wavlm_large_finetune.pth
export SEED_TTS_PARAFORMER_DIR="$HF_MIRROR_ROOT/funasr/paraformer-zh"

# 先用 scripts/prepare_seed_tts_evaluator.sh 从干净官方仓库创建该补丁工作副本。
export SEED_TTS_EVAL_SOURCE_ROOT=/path/to/seed-tts-eval
export SEED_TTS_EVAL_ROOT=/path/to/seed-tts-eval-patched

# 七个离线模型权重。脚本拒绝缺少这些变量，而不会自动下载或猜测路径。
export SEED_TTS_DOTS_MODEL_PATH="$HF_MIRROR_ROOT/rednote-hilab/dots.tts-base"
export SEED_TTS_INDEXTTS_MODEL_PATH="$HF_MIRROR_ROOT/IndexTeam/IndexTTS-2"
export SEED_TTS_LONGCAT_MODEL_PATH="$HF_MIRROR_ROOT/meituan-longcat/LongCat-AudioDiT-1B"
export SEED_TTS_MOSS_MODEL_PATH="$HF_MIRROR_ROOT/OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5"
export SEED_TTS_MOSS_CODEC_PATH="$HF_MIRROR_ROOT/OpenMOSS-Team/MOSS-Audio-Tokenizer-v2"
export SEED_TTS_OMNIVOICE_MODEL_PATH="$HF_MIRROR_ROOT/k2-fsa/OmniVoice"
export SEED_TTS_QWEN3_MODEL_PATH="$HF_MIRROR_ROOT/Qwen/Qwen3-TTS-12Hz-1.7B-Base"
export SEED_TTS_VOXCPM2_MODEL_PATH="$HF_MIRROR_ROOT/openbmb/VoxCPM2"

# Qwen3-TTS 的语音克隆预处理需要 SoX 命令；填写本机可执行文件的绝对路径。
export SEED_TTS_QWEN3_SOX_BIN=/path/to/sox

# 两个模型需要各自的官方源码；不要指向 ~/github/TTS-and-VoiceDesign 的 vendor 目录。
export SEED_TTS_INDEXTTS_CODE_PATH=/path/to/official/index-tts
export SEED_TTS_LONGCAT_CODE_PATH=/path/to/official/LongCat-AudioDiT

# IndexTTS2 使用官方 uv.lock；只有跨机器重建环境且没有完整离线缓存时，才由维护者运行
# scripts/internal/prepare_indextts2_environment.sh --allow-network，再使用公共 test_*.sh 入口。
# export SEED_TTS_UV_BIN=/path/to/uv

# 仅在 Conda 环境名不同于 scripts/model-config.json 默认值时覆盖。
# export SEED_TTS_INDEXTTS2_CONDA_ENV=indextts2
# export SEED_TTS_LONGCAT_AUDIODIT_CONDA_ENV=longcat_audiodit
