{
  "schema_version": 1,
  "benchmark": "Seed-TTS-Eval 中文零样本 TTS（文本转语音）",
  "dataset_splits": {
    "meta": {"list_name": "zh/meta.lst", "expected_count": 2020},
    "hardcase": {"list_name": "zh/hardcase.lst", "expected_count": 400}
  },
  "models": {
    "dots_tts": {
      "display_name": "dots.tts-base",
      "output_dir": "dots_tts",
      "conda_env": "dots_tts",
      "runtime_distribution": "dots-tts",
      "model_path_env": "SEED_TTS_DOTS_MODEL_PATH",
      "required_files": ["config.json", "model.safetensors", "vocoder.safetensors"],
      "parameters": {
        "language": "chinese",
        "precision": "bfloat16",
        "seed": 42,
        "ode_method": "euler",
        "num_steps": 10,
        "guidance_scale": 1.2,
        "speaker_scale": 1.5,
        "max_generate_length": 500
      }
    },
    "indextts2": {
      "display_name": "IndexTTS2",
      "output_dir": "indextts2",
      "conda_env": "indextts2",
      "runtime_distribution": "indextts",
      "model_path_env": "SEED_TTS_INDEXTTS_MODEL_PATH",
      "code_path_env": "SEED_TTS_INDEXTTS_CODE_PATH",
      "required_files": ["config.yaml", "bpe.model", "gpt.pth", "s2mel.pth", "feat1.pt", "feat2.pt", "wav2vec2bert_stats.pt", "qwen0.6bemo4-merge/model.safetensors", "hf_cache/semantic_codec_model.safetensors", "hf_cache/campplus_cn_common.bin", "hf_cache/bigvgan/bigvgan_generator.pt"],
      "parameters": {
        "num_beams": 1,
        "interval_silence": 200,
        "max_text_tokens_per_segment": 120,
        "use_fp16": true,
        "use_cuda_kernel": false,
        "use_deepspeed": false,
        "use_accel": false,
        "use_torch_compile": false
      }
    },
    "longcat_audiodit": {
      "display_name": "LongCat-AudioDiT-1B",
      "output_dir": "longCat",
      "conda_env": "longcat_audiodit",
      "model_path_env": "SEED_TTS_LONGCAT_MODEL_PATH",
      "code_path_env": "SEED_TTS_LONGCAT_CODE_PATH",
      "required_files": ["config.json", "model.safetensors"],
      "parameters": {
        "nfe": 16,
        "guidance_strength": 4.0,
        "guidance_method": "apg",
        "seed": 1024,
        "duration_scale": 1.0,
        "vae_dtype": "float16"
      }
    },
    "moss_tts": {
      "display_name": "MOSS-TTS-Local-Transformer-v1.5",
      "output_dir": "moss_tts",
      "conda_env": "moss-tts-py310",
      "runtime_distribution": "transformers",
      "model_path_env": "SEED_TTS_MOSS_MODEL_PATH",
      "codec_path_env": "SEED_TTS_MOSS_CODEC_PATH",
      "required_files": ["config.json", "model.safetensors", "processing_moss_tts.py"],
      "parameters": {
        "language": "Chinese",
        "max_new_tokens": 4096,
        "audio_temperature": 1.7,
        "audio_top_p": 0.8,
        "audio_top_k": 25,
        "audio_repetition_penalty": 1.0,
        "dtype": "bfloat16",
        "attn_implementation": "sdpa"
      }
    },
    "omnivoice": {
      "display_name": "OmniVoice",
      "output_dir": "omniVoice",
      "conda_env": "omnivoice",
      "runtime_distribution": "omnivoice",
      "model_path_env": "SEED_TTS_OMNIVOICE_MODEL_PATH",
      "required_files": ["config.json", "model.safetensors", "audio_tokenizer/config.json", "audio_tokenizer/model.safetensors"],
      "parameters": {
        "language": "Chinese",
        "dtype": "float16",
        "seed": 42,
        "num_step": 32,
        "guidance_scale": 2.0,
        "speed": 1.0,
        "t_shift": 0.1,
        "denoise": true,
        "preprocess_prompt": true,
        "postprocess_output": true,
        "layer_penalty_factor": 5.0,
        "position_temperature": 5.0,
        "class_temperature": 0.0,
        "audio_chunk_duration": 15.0,
        "audio_chunk_threshold": 30.0,
        "pad_duration": 0.1,
        "fade_duration": 0.1
      }
    },
    "qwen3_tts": {
      "display_name": "Qwen3-TTS-12Hz-1.7B-Base",
      "output_dir": "qwen3_tts",
      "conda_env": "qwen3-tts",
      "runtime_distribution": "qwen-tts",
      "required_executable_env": "SEED_TTS_QWEN3_SOX_BIN",
      "model_path_env": "SEED_TTS_QWEN3_MODEL_PATH",
      "required_files": ["config.json", "model.safetensors", "speech_tokenizer/config.json", "speech_tokenizer/model.safetensors"],
      "parameters": {
        "language": "Chinese",
        "dtype": "bfloat16",
        "attn_implementation": "sdpa",
        "max_new_tokens": 2048
      }
    },
    "voxcpm2": {
      "display_name": "VoxCPM2",
      "output_dir": "voxcpm2",
      "conda_env": "voxcpm2",
      "runtime_distribution": "voxcpm",
      "model_path_env": "SEED_TTS_VOXCPM2_MODEL_PATH",
      "required_files": ["config.json", "model.safetensors", "audiovae.pth", "tokenization_voxcpm2.py"],
      "parameters": {
        "cfg_value": 2.0,
        "inference_timesteps": 10,
        "load_denoiser": false,
        "optimize": false,
        "seed": 20260614
      }
    }
  }
}
