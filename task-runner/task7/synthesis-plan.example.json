        "--model-path", "/path/to/VoxCPM2", "--text-file", "{text_file}", "--ref-audio", "{reference_audio}",
        "--prompt-text", "{reference_transcript}", "--output", "{output_path}", "--segment-manifest", "{segment_manifest}",
        "--segment-evidence-root", "{segment_evidence_root}", "--model-id", "voxcpm2", "--local-files-only"
      ]
