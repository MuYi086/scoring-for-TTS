{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "冻结来源清单记录",
  "type": "object",
  "properties": {
    "source_path": {"type": "string", "minLength": 1},
    "source_collection": {"type": "string", "minLength": 1},
    "source_group": {"type": "string", "minLength": 1},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
    "split": {"enum": ["train", "validation", "blind", "test"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "line_count": {"type": "integer", "minimum": 1},
    "heading_count": {"type": "integer", "minimum": 0}
  },
  "required": [
    "source_path",
    "source_collection",
    "source_group",
    "year",
    "split",
    "sha256",
    "bytes",
    "line_count",
    "heading_count"
  ],
  "additionalProperties": false
}
